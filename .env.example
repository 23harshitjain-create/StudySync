# =============================================================================
# StudySync Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND (Vercel / Vite Client)
# -----------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables, add:
# VITE_API_URL = https://<your-railway-service>.up.railway.app
#
# For Local Development:
VITE_API_URL=demo

# Optional app branding
VITE_APP_NAME=StudySync


# -----------------------------------------------------------------------------
# 2. BACKEND (Railway / Node.js Express Server)
# -----------------------------------------------------------------------------
# Port is injected automatically by Railway, but can be set locally:
PORT=5000
NODE_ENV=production

# (Optional) Google Gemini API Key for LLM task understanding.
# If omitted or empty, StudySync uses its built-in deterministic heuristic NLP.
# GEMINI_API_KEY=your_gemini_api_key_here
